rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email == 'dominikphotofficial.lt@gmail.com';
    }

    match /submissions/{fileName} {
      // Public visitors can upload scripts/treatments up to 25 MB with applicant metadata
      allow create: if request.resource != null
          && request.resource.size < 25 * 1024 * 1024
          && fileName.size() <= 500;
      allow read, delete, update: if isAdmin();
    }

    match /film_uploads/{fileName} {
      allow create: if request.resource != null
          && request.resource.size < 25 * 1024 * 1024
          && fileName.size() <= 500;
      allow read, delete, update: if isAdmin();
    }
  }
}
