rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null 
          && request.auth.token.email == 'dominikphotofficial.lt@gmail.com';
    }

    match /submissions/{fileName} {
      // Public visitors can upload treatments/screenplays up to 25 MB
      allow create: if request.resource.size < 25 * 1024 * 1024;
      allow read, delete, update: if isAdmin();
    }

    match /film_uploads/{fileName} {
      allow create: if request.resource.size < 25 * 1024 * 1024;
      allow read, delete, update: if isAdmin();
    }
  }
}
