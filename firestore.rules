rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email == 'dominikphotofficial.lt@gmail.com';
    }

    function isValidSubmission(data) {
      return data.keys().hasAll(['name', 'handle', 'contact', 'message'])
          && data.name is string
          && data.name.size() > 0
          && data.name.size() <= 120
          && data.handle is string
          && data.handle.size() > 0
          && data.handle.size() <= 200
          && data.contact is string
          && data.contact.size() > 0
          && data.contact.size() <= 250
          && data.message is string
          && data.message.size() > 0
          && data.message.size() <= 8000
          && (!('status' in data) || data.status == 'new');
    }

    function isValidPublicAdminNotification(data) {
      return data.keys().hasAll(['to', 'message'])
          && !('template' in data)
          && data.to is list
          && data.to.size() == 1
          && data.to[0] == 'info@dominikphotofficial.lt'
          && (!('from' in data) || data.from == 'DP.FILMS <films@dominikphotofficial.lt>')
          && (!('replyTo' in data) || data.replyTo == 'info@dominikphotofficial.lt')
          && data.message is map
          && data.message.keys().hasAll(['subject', 'text', 'html'])
          && data.message.subject is string
          && data.message.subject.size() > 0
          && data.message.subject.size() <= 250
          && data.message.text is string
          && data.message.text.size() > 0
          && data.message.text.size() <= 15000
          && data.message.html is string
          && data.message.html.size() > 0
          && data.message.html.size() <= 30000;
    }

    // Film Team Submissions & Pitch Inquiries
    match /submissions/{submissionId} {
      allow create: if isValidSubmission(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Trigger Email Queue (firebase/firestore-send-email)
    // Automated sender: films@dominikphotofficial.lt · Inbox/Reply-To: info@dominikphotofficial.lt
    match /mail/{mailId} {
      allow create: if isValidPublicAdminNotification(request.resource.data) || isAdmin();
      allow read, update, delete: if isAdmin();
    }

    // Reusable Email Templates
    match /mailTemplates/{templateId} {
      allow read, write: if isAdmin();
    }
  }
}
