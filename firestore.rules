rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Verify if the authenticated user is the designated portfolio admin
    function isAdmin() {
      return request.auth != null 
          && request.auth.token.email == 'dominikphotofficial.lt@gmail.com';
    }

    // =========================================================================
    // Photography Portfolio Rules (PRESERVED - DO NOT DELETE)
    // =========================================================================
    match /submissions/{submissionId} {
      allow create: if request.resource.data.name is string;
      allow read, update, delete: if isAdmin();
    }

    // =========================================================================
    // Film Portfolio Rules (APPENDED)
    // =========================================================================
    match /film_submissions/{submissionId} {
      // Public visitors can only submit forms (no public read/list/delete)
      allow create: if request.resource.data.name is string
                    && request.resource.data.contactType is string
                    && request.resource.data.handle is string
                    && request.resource.data.message is string;

      // Full management access strictly for Dominik Šuškevič
      allow read, update, delete: if isAdmin();
    }

    // Email queue / notification collection (Firebase Trigger Email extension)
    match /mail/{mailId} {
      allow read, write: if isAdmin();
    }
  }
}
